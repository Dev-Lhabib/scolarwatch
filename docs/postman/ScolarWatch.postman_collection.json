{
  "info": {
    "name": "ScolarWatch API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "auth_token", "value": "" },
    { "key": "matiere_id", "value": "" },
    { "key": "classe_id", "value": "" },
    { "key": "eleve_id", "value": "" },
    { "key": "note_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Login (email)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/login", "body": { "mode": "raw", "raw": "{\"identifiant\": \"admin@scolarwatch.test\", \"password\": \"password\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Login (username)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/login", "body": { "mode": "raw", "raw": "{\"identifiant\": \"admin\", \"password\": \"password\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Login - wrong password (422)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/login", "body": { "mode": "raw", "raw": "{\"identifiant\": \"admin\", \"password\": \"wrong\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/logout" } },
        { "name": "Create user (admin only) - POST /users", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/users", "body": { "mode": "raw", "raw": "{\"nom\": \"Test\", \"prenom\": \"User\", \"username\": \"postmanuser\", \"email\": \"postmanuser@scolarwatch.test\", \"password\": \"password123\", \"role\": \"parent\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Create user - no token (401)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/users", "body": { "mode": "raw", "raw": "{\"nom\": \"Test\", \"prenom\": \"User\", \"username\": \"failuser\", \"email\": \"fail@scolarwatch.test\", \"password\": \"password123\", \"role\": \"parent\"}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Matieres",
      "item": [
        { "name": "List matieres (index)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/matieres" } },
        { "name": "List matieres - no token (401)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/matieres" } },
        { "name": "Create matiere (store)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/matieres", "body": { "mode": "raw", "raw": "{\"nom\": \"Informatique\", \"code\": \"INFO\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Create matiere - missing fields (422)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/matieres", "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Show matiere", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/matieres/{{matiere_id}}" } },
        { "name": "Update matiere", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/matieres/{{matiere_id}}", "body": { "mode": "raw", "raw": "{\"nom\": \"Informatique Avancee\", \"code\": \"INFO\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Delete matiere (admin only)", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/matieres/{{matiere_id}}" } }
      ]
    },
    {
      "name": "Classes",
      "item": [
        { "name": "List classes (index)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/classes" } },
        { "name": "Create classe (admin only)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/classes", "body": { "mode": "raw", "raw": "{\"nom\": \"1AC-A\", \"niveau\": \"1AC\", \"annee_scolaire\": \"2025-2026\", \"capacite\": 30}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Show classe", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/classes/{{classe_id}}" } },
        { "name": "Assign professeur principal", "request": { "method": "PATCH", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/classes/{{classe_id}}/professeur-principal", "body": { "mode": "raw", "raw": "{\"id_utilisateur_principal\": 3}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Assign enseignant to classe", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/classes/{{classe_id}}/enseignants", "body": { "mode": "raw", "raw": "{\"id_utilisateur\": 3}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Delete classe (admin only)", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/classes/{{classe_id}}" } }
      ]
    },
    {
      "name": "Eleves",
      "item": [
        { "name": "List eleves (index)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/eleves" } },
        { "name": "Create eleve with tuteurs (admin only)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/eleves", "body": { "mode": "raw", "raw": "{\"nom\": \"Alaoui\", \"prenom\": \"Youssef\", \"genre\": \"M\", \"date_naissance\": \"2013-05-10\", \"id_classe\": {{classe_id}}, \"tuteur_ids\": []}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Show eleve", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/eleves/{{eleve_id}}" } },
        { "name": "Update eleve (sync tuteurs)", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/eleves/{{eleve_id}}", "body": { "mode": "raw", "raw": "{\"nom\": \"Alaoui\", \"prenom\": \"Youssef\", \"genre\": \"M\", \"date_naissance\": \"2013-05-10\", \"id_classe\": {{classe_id}}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Delete eleve (admin only)", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/eleves/{{eleve_id}}" } }
      ]
    },
    {
      "name": "Notes",
      "item": [
        { "name": "List notes (index)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/notes" } },
        { "name": "Create note (enseignant - own classe/matiere)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/notes", "body": { "mode": "raw", "raw": "{\"valeur\": 15.5, \"trimestre\": \"T1\", \"date\": \"2026-01-15\", \"id_eleve\": {{eleve_id}}, \"id_matiere\": {{matiere_id}}}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Show note", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/notes/{{note_id}}" } }
      ]
    },
    {
      "name": "Absences",
      "item": [
        { "name": "List absences (index)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/absences" } },
        { "name": "Create absence", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/absences", "body": { "mode": "raw", "raw": "{\"date_absence\": \"2026-01-15\", \"justifiee\": false, \"id_eleve\": {{eleve_id}}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Retards",
      "item": [
        { "name": "List retards (index)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/retards" } },
        { "name": "Create retard", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/retards", "body": { "mode": "raw", "raw": "{\"date_retard\": \"2026-01-15\", \"minutes_retard\": 10, \"id_eleve\": {{eleve_id}}}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Remarques",
      "item": [
        { "name": "List remarques (index)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }], "url": "{{base_url}}/remarques" } },
        { "name": "Create remarque", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/remarques", "body": { "mode": "raw", "raw": "{\"contenu\": \"Ne participe plus depuis le retour des vacances.\", \"trimestre\": \"T1\", \"date_remarque\": \"2026-01-15\", \"id_eleve\": {{eleve_id}}}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "GET /health", "request": { "method": "GET", "url": "{{base_url}}/health" } }
      ]
    }
  ]
} 
