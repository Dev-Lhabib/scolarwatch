{
  "info": {
    "name": "ScolarWatch API - Sprint 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "auth_token", "value": "" },
    { "key": "matiere_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"identifiant\": \"admin@scolarwatch.test\", \"password\": \"password\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login (username)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"identifiant\": \"admin\", \"password\": \"password\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login - wrong password (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"identifiant\": \"admin\", \"password\": \"wrong\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/logout"
          }
        },
        {
          "name": "Create user (admin only) - POST /users",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Test\", \"prenom\": \"User\", \"username\": \"postmanuser\", \"email\": \"postmanuser@scolarwatch.test\", \"password\": \"password123\", \"role\": \"parent\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create user - no token (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Test\", \"prenom\": \"User\", \"username\": \"failuser\", \"email\": \"fail@scolarwatch.test\", \"password\": \"password123\", \"role\": \"parent\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Matieres",
      "item": [
        {
          "name": "List matieres (index)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/matieres"
          }
        },
        {
          "name": "List matieres - no token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/matieres"
          }
        },
        {
          "name": "Create matiere (store)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/matieres",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Informatique\", \"code\": \"INFO\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Create matiere - missing fields (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/matieres",
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Show matiere",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/matieres/{{matiere_id}}"
          }
        },
        {
          "name": "Update matiere",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/matieres/{{matiere_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Informatique Avancee\", \"code\": \"INFO\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete matiere (admin only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/matieres/{{matiere_id}}"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{base_url}}/health" }
        }
      ]
    }
  ]
}
